  "text": {
    "heroKicker": "Welcome to",
    "heroTitle": "RC CENTER",
    "heroSubtitle": "Ravi Chettu Center, Minagallu Village. Celebrating Ganesh Utsav together as one family.",
    "heroQuote": "\"With the blessings of Lord Ganesha, we celebrate unity, faith and joy.\"",
    "heroChant": "Ganpati Bappa Morya!",
    "tickerWords": [
      "Ganpati Bappa Morya",
      "Om Gan Ganapataye Namaha",
      "Jai Ganesh",
      "Ganpati Bappa Morya",
      "Vighna Harta, remover of obstacles"
    ],
    "watermark": "GANPATI BAPPA MORYA",
    "highlightsTitle": "Festival highlights",
    "highlightsIntro": "Our best memories, photos and reels from the festival.",
    "noteTitle": "A note from our village",
    "noteBody": [
      "Dear friends and devotees, thank you for visiting our website.",
      "Every year our village comes together to celebrate Ganesh Utsav with faith and togetherness. This website keeps our photos, videos and memories safe, so our children and future families can see them.",
      "Everyone is welcome to join our festival. Ganpati Bappa Morya!"
    ],
    "noteSignature": "RC Center, Ravi Chettu Center",
    "aboutTitle": "About our centre",
    "aboutLead": "Ravi Chettu Center is the place where our whole village meets for Ganesh Utsav.",
    "aboutParagraphs": [
      "Every year, when Ganesh Chaturthi comes, our village becomes full of joy. The whole village gathers at the Ravi Chettu Centre to celebrate.",
      "We worship Lord Ganesha with a full heart. Young and old, all sit together and share the work and the joy.",
      "Our celebrations include daily pooja, a big community meal, evening bhajans, games for children, the Utti festival, and the farewell to Lord Ganesha."
    ],
    "aboutPointsTitle": "What we do every year",
    "aboutPoints": [
      "Pray to Lord Ganesha and ask for his blessings.",
      "Serve food to every devotee who comes.",
      "Keep our old Utti festival tradition alive.",
      "Say a happy goodbye to Lord Ganesha with a farewell procession."
    ],
    "factsTitle": "FACTS",
    "facts": [
      "Lord Ganesha is worshipped first, before starting any new work or puja.",
      "Ganesh Chaturthi is celebrated for 10 days in many places. Some families keep Ganesha for 1, 3, 5 or 7 days.",
      "Modak is Lord Ganesha's favourite sweet, so it is offered in the pooja.",
      "Lord Ganesha is called Vighnaharta, the remover of obstacles.",
      "On the last day, the idol is taken for immersion (Nimajjanam) with singing, dancing and the chant \"Ganpati Bappa Morya!\"",
      "Ganesha is a symbol of wisdom, good luck and new beginnings.",
      "Our village celebrates together under one tree, which shows our unity."
    ],
    "celebrationTitle": "Our festival days",
    "celebrationParagraphs": [
      "Our Ganesh Utsav is held at the Ravi Chettu Center. The whole village helps with decorations, food and programmes.",
      "Each day has its own programme: pooja in the morning and evening, bhajans at night, and cultural programmes for children and families."
    ],
    "closingChant": "Our Ganesha, our festival, our village, our Ravi Chettu Center!",
    "heartText": "Touch this heart if you love Lord Ganesha"
  },
